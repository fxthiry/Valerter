#!/bin/sh
set -e

case "$1" in
    purge)
        # Remove user and group only on purge
        if id valerter >/dev/null 2>&1; then
            userdel valerter || true
        fi
        if getent group valerter >/dev/null; then
            groupdel valerter || true
        fi
        # Remove config directory
        rm -rf /etc/valerter || true
        # Reload systemd (if it is the running init)
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
        fi
        ;;
    remove)
        # prerm already stopped and disabled the service (the user is kept
        # for a potential reinstall)
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
        fi
        ;;
esac

exit 0
