#!/bin/sh
set -e

case "$1" in
    remove|deconfigure)
        # Stop the service before its files are removed, when systemd is the
        # running init. Unconditional stop: a unit in `activating
        # (auto-restart)` is not "active" but would be restarted onto a
        # deleted binary. Not on upgrade: the running process keeps the old
        # binary mapped and postinst restarts it, so downtime is limited to
        # the restart.
        if [ -d /run/systemd/system ]; then
            systemctl stop valerter 2>/dev/null || true
            if [ "$1" = remove ]; then
                systemctl disable valerter 2>/dev/null || true
            fi
        fi
        ;;
esac

exit 0
