#!/bin/sh
set -e

case "$1" in
    configure)
        # Create system group if not exists
        if ! getent group valerter >/dev/null; then
            groupadd --system valerter
        fi
        # Create system user if not exists
        if ! id valerter >/dev/null 2>&1; then
            useradd --system --no-create-home --shell /usr/sbin/nologin --gid valerter valerter
        fi
        # Set ownership and permissions on config directory
        if [ -d /etc/valerter ]; then
            chown root:valerter /etc/valerter
            chmod 750 /etc/valerter
        fi
        # Set permissions on config file (contains secrets)
        if [ -f /etc/valerter/config.yaml ]; then
            chown root:valerter /etc/valerter/config.yaml
            chmod 640 /etc/valerter/config.yaml
        fi
        # Create .d/ directories for multi-file config
        for dir in rules.d templates.d notifiers.d; do
            if [ ! -d /etc/valerter/$dir ]; then
                mkdir -p /etc/valerter/$dir
                chown root:valerter /etc/valerter/$dir
                chmod 750 /etc/valerter/$dir
            fi
        done
        # Set permissions on templates directory
        if [ -d /etc/valerter/templates ]; then
            chown -R valerter:valerter /etc/valerter/templates
            chmod 755 /etc/valerter/templates
            find /etc/valerter/templates -type f -exec chmod 644 {} \;
        fi
        # Reload systemd and restart the service, only when systemd is the
        # running init (not in a container or chroot, where the binary may be
        # present without a manager)
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
            # Restart service on upgrade (not on fresh install) when it is
            # active or enabled. The enabled check also covers upgrades from
            # <= 2.0.3, whose prerm already stopped the service.
            if [ -n "$2" ]; then
                if systemctl is-active --quiet valerter 2>/dev/null \
                    || systemctl is-enabled --quiet valerter 2>/dev/null; then
                    systemctl restart valerter || true
                    # Give an invalid config time to make the process exit,
                    # then warn loudly without failing dpkg.
                    sleep 2
                    if ! systemctl is-active --quiet valerter 2>/dev/null; then
                        cat >&2 <<'WARN'

############################################################
WARNING: valerter failed to start after upgrade
The service is not running: no alerts are being sent.
Check the logs with: journalctl -u valerter
Then fix the configuration and run: systemctl restart valerter
############################################################

WARN
                    fi
                fi
            fi
        fi
        ;;
esac

exit 0
